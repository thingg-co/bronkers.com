# RPC endpoint (anvil default shown)
RPC_URL=http://127.0.0.1:8545

# Executor key: a BURNER. It can only call ExecutionGuard.executeTrade within
# policy — it cannot withdraw even if this whole machine is compromised.
# The owner key must NEVER be configured here.
EXECUTOR_PRIVATE_KEY=0x...

# Only needed for the real brain; MockBrain (--mock-brain) needs no key.
ANTHROPIC_API_KEY=

# The trader this runtime embodies
TOKEN_ID=1
TRADER_NFT_ADDRESS=0x...
GUARD_ADDRESS=0x...
ROUTER_ADDRESS=0x...

# Genome blob + decryption material. Two custody families:
#  - authored (custody 0): GENOME_KEY (AES key handed over on sale)
#  - sealed  (custody 1/2): ENCLAVE_PRIVATE_KEY — in production this key lives
#    only inside a TEE; here the runtime process plays the enclave role.
# Run `npm run genome -- keygen` once to create the enclave keypair.
GENOME_PATH=./genome.local.json
GENOME_KEY=
ENCLAVE_PUBLIC_KEY=
ENCLAVE_PRIVATE_KEY=
